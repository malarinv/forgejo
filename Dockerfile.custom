# Custom Forgejo build with package event webhook header fix
# Rootless variant matching official Dockerfile.rootless

# Stage 1: Build frontend on native platform
FROM --platform=linux/amd64 node:20-alpine AS frontend

RUN apk --no-cache add git

WORKDIR /src
COPY . .

RUN npm install && \
    npx webpack --mode production

# Stage 2: Build backend for target platform
FROM --platform=$TARGETPLATFORM golang:1.25-alpine AS build

ARG RELEASE_VERSION=15.0.3-custom
ARG TAGS="sqlite sqlite_unlock_notify"

ENV CGO_ENABLED=1

RUN apk --no-cache add \
    build-base \
    git \
    musl-dev \
    gcc

WORKDIR /src
COPY . .

# Copy pre-built frontend assets
COPY --from=frontend /src/public/assets ./public/assets

# Build backend
RUN make clean-no-bindata && \
    LDFLAGS="-buildid=" make \
    FORGEJO_GENERATE_SKIP_HASH=true \
    RELEASE_VERSION=${RELEASE_VERSION} \
    GOFLAGS="-trimpath" \
    GO=go \
    go-check generate-backend static-executable

# Stage 3: Rootless runtime image
FROM alpine:3.19

ARG RELEASE_VERSION
LABEL org.opencontainers.image.source="https://github.com/malarinv/forgejo"
LABEL org.opencontainers.image.description="Forgejo rootless with package event webhook header fix"
LABEL org.opencontainers.image.version="${RELEASE_VERSION}"

RUN apk --no-cache add \
    bash \
    ca-certificates \
    dumb-init \
    openssh-client \
    wget

# Create git user (rootless runs as UID 1000)
RUN addgroup -g 1000 git && \
    adduser -D -u 1000 -G git -h /var/lib/gitea/git -s /bin/bash git && \
    mkdir -p /var/lib/gitea /var/lib/gitea/custom /var/lib/gitea/data /var/lib/gitea/log /tmp/gitea && \
    chown -R 1000:1000 /var/lib/gitea /tmp/gitea

# Copy built binary
COPY --from=build --chown=root:root /src/gitea /app/gitea/gitea
RUN ln -s /app/gitea/gitea /app/gitea/forgejo-cli

# Copy rootless entrypoint and setup scripts
COPY --from=build /src/docker/rootless /tmp/local
RUN chmod 755 /tmp/local/usr/local/bin/docker-entrypoint.sh && \
    cp -a /tmp/local/* / && \
    rm -rf /tmp/local

EXPOSE 2222 3000

USER 1000:1000
ENV GITEA_WORK_DIR=/var/lib/gitea
ENV GITEA_CUSTOM=/var/lib/gitea/custom
ENV GITEA_TEMP=/tmp/gitea
ENV TMPDIR=/tmp/gitea
ENV GITEA_APP_INI=${GITEA_CUSTOM}/conf/app.ini
ENV HOME="/var/lib/gitea/git"
VOLUME ["/var/lib/gitea"]
WORKDIR /var/lib/gitea

ENTRYPOINT ["/usr/bin/dumb-init", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["/usr/local/bin/gitea", "web"]
